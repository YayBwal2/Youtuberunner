# ==============================================================
# YouTube Runner - Environment Configuration
# ==============================================================

# 1. Google Gemini API Key (100% Free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Voice Configuration (edge-tts voices)
# Recommended natural neural voices:
# - en-US-ChristopherNeural (Authoritative, energetic tech voice)
# - en-US-GuyNeural (Casual, engaging)
# - en-US-JennyNeural (Natural female narrator)
VOICE_NAME=en-US-ChristopherNeural
VOICE_RATE=+10%
VOICE_PITCH=+0Hz

# 3. YouTube Upload Settings (YouTube Data API v3)
# Set to 'private', 'unlisted', or 'public'
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# 4. Pipeline Defaults
VIDEO_FORMAT=shorts
AUTOPUBLISH_SCHEDULE=18:00
DEFAULT_NICHE="Tech & AI Breakthroughs"
